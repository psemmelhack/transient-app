{
  "expo": {
    "name": "Transient",
    "slug": "transient-app",
    "scheme": "transient",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#f3f0ea"
    },
    "owner": "psemme",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/fc828c9a-1d94-4a4f-8b11-9156e69011b1"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Transient uses your location to record where you are.",
        "NSPhotoLibraryAddUsageDescription": "Transient saves the image to your photos.",
        "NSMotionUsageDescription": "Transient reads motion, heading, and today’s steps when Telemetry is on."
      }
    },
    "android": {
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACTIVITY_RECOGNITION"
      ]
    },
    "experiments": {
      "baseUrl": ""
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Transient",
      "shortName": "Transient",
      "themeColor": "#f3f0ea",
      "backgroundColor": "#f3f0ea",
      "display": "standalone",
      "startUrl": "/",
      "lang": "en"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Transient uses your location to record where you are."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Transient saves the image to your photos.",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "expo-sharing",
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "fc828c9a-1d94-4a4f-8b11-9156e69011b1"
      }
    }
  }
}
